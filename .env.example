# --- Qdrant Cloud -----------------------------------------------------------
# Create a free cluster at https://cloud.qdrant.io, then copy URL + API key
# from the cluster's "Connect" panel in the Web UI.
QDRANT_URL=https://xxxxxxxx.us-east.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=the_qdrant_api_key_here

# --- LLM --------------------------------------------------------------------
# Free API key from https://aistudio.google.com/apikey
GOOGLE_API_KEY=the_google_api_key_here

# --- Defaults (no need to change) -------------------------------------------
COLLECTION_NAME=langchain_qdrant_docs
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
LLM_MODEL=gemini-2.0-flash
URLS_FILE=data/urls.txt
